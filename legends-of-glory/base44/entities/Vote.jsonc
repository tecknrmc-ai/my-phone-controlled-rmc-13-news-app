{
  "name": "Vote",
  "type": "object",
  "properties": {
    "artist_id": {
      "type": "string",
      "description": "ID of the artist being voted for"
    },
    "artist_name": {
      "type": "string",
      "description": "Name of the artist voted for"
    },
    "voter_fingerprint": {
      "type": "string",
      "description": "Browser fingerprint to prevent duplicate votes"
    }
  },
  "required": [
    "artist_id",
    "artist_name"
  ]
}
